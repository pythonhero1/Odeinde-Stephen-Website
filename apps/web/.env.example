# ==============================================================================
# Oderinde Stephen Headless - Frontend Environment Configuration (.env.example)
# Copy to .env.local for local development. Never commit live secrets or credentials.
# Per docs/environment.md: Booking URL, contact email, and business details are
# CMS settings, not environment variables.
# ==============================================================================

# Public & Application Origins (Server Only)
SITE_URL=https://oderindestephen.com
APP_ORIGIN=http://localhost:3000
WP_API_ORIGIN=http://localhost:8080

# Dedicated WordPress Preview Reader (Server Only)
WP_PREVIEW_USER=headless_preview
WP_PREVIEW_APPLICATION_PASSWORD=

# Server-to-Server Shared Secrets (Server Only - Must match WordPress Plugin)
PREVIEW_SIGNING_SECRET=
REVALIDATION_SECRET=
CMS_BRIDGE_SECRET=

# Cloudflare Turnstile (Spam Protection)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Analytics (Public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
