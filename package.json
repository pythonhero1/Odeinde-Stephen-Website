{
  "name": "oderindestephen-headless",
  "version": "0.1.0",
  "private": true,
  "description": "Headless marketing website for Oderinde Stephen",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm.cmd --prefix apps/web run dev",
    "build": "npm.cmd --prefix apps/web run build",
    "start": "npm.cmd --prefix apps/web run start",
    "lint": "npm.cmd --prefix apps/web run lint",
    "typecheck": "npm.cmd --prefix apps/web run typecheck",
    "test": "npm.cmd --prefix apps/web run test",
    "test:e2e": "npm.cmd --prefix apps/web run test:e2e",
    "php:lint": "powershell -NoProfile -Command \"$php = \\\"$env:APPDATA\\Local\\lightning-services\\php-8.2.29+0\\bin\\win64\\php.exe\\\"; Get-ChildItem -Path wordpress -Filter *.php -Recurse | ForEach-Object { & $php -l $_.FullName }\"",
    "kit:check": "node tools/check-kit.mjs",
    "memory:check": "py -3 tools/check-memory.py"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
